# Copy to .env.local to run analytics against a real property locally — but
# note src/analytics.ts also requires a production build, so a dev server stays
# silent either way. Normally this variable is only set in Vercel.
#
# Vite inlines VITE_* variables at build time, so changing this in Vercel needs
# a redeploy to take effect.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
